<configuration>
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/MonitorGlobal.log</file> <!-- Ruta y nombre del archivo -->
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/miservicio.%d{yyyy-MM-dd}.log</fileNamePattern> <!-- Archivo por día -->
            <maxHistory>30</maxHistory> <!-- Mantener logs de los últimos 30 días -->
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">  <!-- puede ser INFO o DEBUG o ERROR -->
        <appender-ref ref="FILE" />
    </root>
</configuration>
